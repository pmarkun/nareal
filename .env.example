# URL pública exata do serviço; use http://localhost:3000 no desenvolvimento.
APP_URL=http://localhost:3000
# Railway: monte um volume em /data e mantenha UMA réplica.
DATABASE_PATH=./data/nareal.sqlite
ADMIN_USERNAME=admin
# Gere com npm run password:hash. Não use uma senha em texto aberto.
ADMIN_PASSWORD_HASH=
# Opcional: backend compatível com OpenAI para checagem no servidor.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
